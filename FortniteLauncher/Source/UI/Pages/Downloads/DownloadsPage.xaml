<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FortniteLauncher.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="58,32,58,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="InstallDirHeaderText"
                   Grid.Row="0"
                   Margin="2,0,8,4"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   FontWeight="SemiBold"
                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>

        <Grid Grid.Row="1"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              CornerRadius="4"
              Padding="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <FontIcon Glyph="&#xED25;"
                      FontSize="30"
                      Margin="0,0,12,0"
                      Grid.Column="0"/>

            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="CurrentPathText"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="BuildPathText"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button x:Name="SelectPathButton"
                    Click="ChangeInstallPath"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    FontWeight="SemiBold"/>
        </Grid>

        <TextBlock x:Name="BuildHeaderText"
                   Grid.Row="2"
                   Margin="2,8,8,4"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   FontWeight="SemiBold"
                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>

        <InfoBar x:Name="DownloadInProgressInfoBar"
                 IsClosable="False"
                 Grid.Row="3"
                 Margin="0,4,0,4"
                 FontWeight="SemiBold"/>

        <Grid Grid.Row="4"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              Padding="8"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              CornerRadius="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <FontIcon Glyph="&#xE896;"
                      FontSize="30"
                      Margin="0,0,12,0"
                      Grid.Column="0"/>

            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="InstallHeaderText"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="InstallBodyText"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button x:Name="DownloadBuildButton"
                    Click="DownloadBuild"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    FontWeight="SemiBold"/>
        </Grid>

        <TextBlock x:Name="UninstallSectionHeaderText"
                   Grid.Row="5"
                   Margin="2,8,8,4"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   FontWeight="SemiBold"
                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>

        <Grid Grid.Row="6"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              Padding="8"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              CornerRadius="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <FontIcon Glyph="&#xE74D;"
                      FontSize="30"
                      Margin="0,0,12,0"
                      Grid.Column="0"/>

            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="UninstallHeaderText"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="UninstallBodyText"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button x:Name="Delete"
                    Click="DeleteBuild"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Page>