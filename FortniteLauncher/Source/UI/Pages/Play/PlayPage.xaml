<Page
    x:Class="FortniteLauncher.Pages.PlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FortniteLauncher.Pages"
    xmlns:controls="using:CommunityToolkit.Labs.WinUI"
    xmlns:media="using:CommunityToolkit.WinUI.UI.Media"
xmlns:ui="using:CommunityToolkit.WinUI.UI"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <media:AttachedCardShadow x:Key="PurpleGlow"
                                   Color="#9B5CFF"
                                   Opacity="0.55"
                                   BlurRadius="28"
                                   Offset="0"
                                   CornerRadius="8"/>

        <media:AttachedCardShadow x:Key="TealGlow"
                                   Color="#39E5C5"
                                   Opacity="0.55"
                                   BlurRadius="28"
                                   Offset="0"
                                   CornerRadius="8"/>
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder" CornerRadius="8" Margin="0,0,0,4" Height="215">
            <Grid>
                <Image x:Name="BannerImage" Stretch="UniformToFill">
                    <Image.Source>
                        <BitmapImage UriSource="ms-appx:///Content/Texture/UI/T_Banner.png" CreateOptions="IgnoreImageCache"/>
                    </Image.Source>
                </Image>

                <Border x:Name="HeaderBlurBorder" CornerRadius="8">
                    <Border.Background>
                        <SolidColorBrush x:Name="OverlayBrush" Color="#B2000000"/>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Border Padding="8" x:Name="HeaderProfileBanner">
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="ProfileContainer" VerticalAlignment="Center">
                        <Border x:Name="BlurredBackground" Width="96" Height="96" CornerRadius="20" Background="Gray" Opacity="0.1"/>
                        <Border Width="96" Height="96" CornerRadius="20">
                            <Border.Background>
                                <ImageBrush x:Name="ProfileImageBrush">
                                    <ImageBrush.Transform>
                                        <ScaleTransform ScaleX="1" CenterX="100"/>
                                    </ImageBrush.Transform>
                                </ImageBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <TeachingTip x:Name="DownloadInfo"
                                 Title="Downloading Required Files"
                                 Subtitle="{x:Bind Progress}"
                                 FontWeight="SemiBold">
                        <TeachingTip.IconSource>
                            <SymbolIconSource Symbol="Download"/>
                        </TeachingTip.IconSource>
                    </TeachingTip>

                    <StackPanel VerticalAlignment="Center" Grid.Column="1" Margin="15,0,0,0">
                        <TextBlock x:Name="GreetingText"
           FontSize="24"
           FontWeight="Bold"
           Foreground="White"
           Style="{ThemeResource TitleTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                            <TextBlock x:Name="DescriptionPre"
                                       Text="There are currently "
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <HyperlinkButton x:Name="PlayerCountButton"
                                             Content="... players"
                                             FontSize="16"
                                             FontWeight="SemiBold"
                                             Foreground="White"
                                             Padding="0"
                                             Margin="2.5,0,2.5,0"
                                             VerticalAlignment="Center"
                                             Click="ShowPlayerList"/>
                            <TextBlock x:Name="OnlineOnEonText"
                                       Text="online on Eon."
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="2,0,2,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:SettingsCard x:Name="DonationsCard"
                                   Grid.Column="0"
                                   Header="Donations"
                                   Description="Contribute to the community and unlock exclusive perks."
                                   Click="Donations"
                                   FontWeight="SemiBold"
                                   BorderBrush="#9B5CFF"
                                   BorderThickness="1.2"
                                   CornerRadius="8"
                                   ui:Effects.Shadow="{StaticResource PurpleGlow}">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Content/Texture/UI/T_Donate.png"/>
                </controls:SettingsCard.HeaderIcon>
                <Button x:Name="DonationsButton" 
                        Click="Donations" 
                        Content="Donate"
                        FontWeight="SemiBold"/>
            </controls:SettingsCard>

            <controls:SettingsCard x:Name="TiktokCard"
                                   Grid.Column="2"
                                   Header="Tiktok"
                                   Description="Follow us for sneak peeks and exclusive content."
                                   Click="Tiktok"
                                   FontWeight="SemiBold"
                                   BorderBrush="#39E5C5"
                                   BorderThickness="1.2"
                                   CornerRadius="8"
                                   ui:Effects.Shadow="{StaticResource TealGlow}">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Content/Texture/UI/T_Tiktok.png"/>
                </controls:SettingsCard.HeaderIcon>
                <Button x:Name="TiktokButton" 
                        Click="Tiktok" 
                        Content="View"
                        FontWeight="SemiBold"/>
            </controls:SettingsCard>
        </Grid>

        <controls:SettingsCard x:Name="LaunchButton"
                       x:FieldModifier="public"
                       Grid.Row="2"
                       Tag="Launch"
                       Margin="4,2,4,2"
                       IsClickEnabled="True"
                       IsActionIconVisible="False"
                       Click="Launch"
                       FontWeight="SemiBold">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE768;"/>
            </controls:SettingsCard.HeaderIcon>
        </controls:SettingsCard>
    </Grid>
</Page>
